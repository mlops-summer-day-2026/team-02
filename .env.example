# Скопируй в .env:  cp .env.example .env
# .env лежит в .gitignore и на GitHub не уедет. Репозиторий публичный:
# утёкший ключ отзывается за минуты. В код и промпты ключ не вставлять.

# Токен Telegram нужно получать у @BotFather и немедленно ротировать при утечке.
TELEGRAM_BOT_TOKEN=

# Codex вызывается через OpenAI Responses API.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.3-codex
OPENAI_REASONING_EFFORT=medium

# Локальный TeraTTS должен принимать JSON и возвращать OGG/Opus, M4A или MP3.
TERATTS_URL=http://127.0.0.1:8001/synthesize
TERATTS_TIMEOUT_SECONDS=30

# Настройки локального MVP.
DATABASE_PATH=./data/bot.sqlite3
REPOSITORIES_DIR=./data/repositories
WHITELIST_PATH=./whitelist.txt
DEFAULT_REPOSITORY_USER=@nafanyah
DEFAULT_REPOSITORY_URL=https://github.com/mlops-summer-day-2026/team-02
MAX_REPOSITORY_BYTES=1000000
